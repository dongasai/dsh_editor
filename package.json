{
  "name": "@dongasai/dsh-editor",
  "version": "1.2.0",
  "type": "module",
  "description": "Edit, create, rename, copy, delete and paste workspace files in the DSH web GUI: an editable document renderer, a file-tree sidebar tool with its own clipboard, and six trusted host routes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongasai/dsh_editor.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "editor",
    "file-tree",
    "file-manager",
    "workspace"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "工作区文件编辑器",
    "description": "在右侧栏直接编辑并整理工作区文件：预览里改完就存，外加一个自带文件树的「文件编辑」工具。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "IMPLEMENTATION.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}
